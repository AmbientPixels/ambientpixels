{
  "bindings": [
    {
      "authLevel": "anonymous",
      "type": "httpTrigger",
      "direction": "in",
      "name": "req",
      "methods": [
        "get"
      ]
    },
    {
      "type": "http",
      "direction": "out",
      "name": "res"
    },
    {
      "type": "blob",
      "name": "inputBlob",
      "path": "cardforge/user/{headers.x-ms-client-principal-id}/cards.json",
      "connection": "AZURE_STORAGE_CONNECTION_STRING",
      "direction": "in"
    }
  ],
  "scriptFile": "index.js"
}
