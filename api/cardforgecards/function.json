{
  "bindings": [
    {
      "authLevel": "anonymous",
      "type": "httpTrigger",
      "direction": "in",
      "name": "req",
      "methods": [
        "get"
      ],
      "route": "cardforgecards"
    },
    {
      "type": "http",
      "direction": "out",
      "name": "res"
    },
    {
      "type": "blob",
      "direction": "in",
      "name": "cardBlob",
      "path": "cardforge/cards.json",
      "connection": "AZURE_STORAGE_CONNECTION_STRING"
    }
  ]
}
