    },
    {
      "route": "/api/agent-create-content",
      "rewrite": "https://ambientpixels-nova-api.azurewebsites.net/api/agent-create-content",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/agent-run-campaign",
      "rewrite": "https://ambientpixels-nova-api.azurewebsites.net/api/agent-run-campaign",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/formIntake",
      "rewrite": "https://ambientpixels-nova-api.azurewebsites.net/api/formIntake",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/formIntake/*",
      "rewrite": "https://ambientpixels-nova-api.azurewebsites.net/api/formIntake/{path}",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/formIntakeDigest",
      "rewrite": "https://ambientpixels-nova-api.azurewebsites.net/api/formIntakeDigest",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/tasks/mark-replied",
      "rewrite": "https://ambientpixels-nova-api.azurewebsites.net/api/tasks/mark-replied",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/telemetry/summary",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/*",
      "rewrite": "https://ambientpixels-nova-api.azurewebsites.net/api/{path}"
    },
    {
      "route": "/cardforge/*.css",
      "allowedRoles": ["anonymous"],
      "headers": {
        "Cache-Control": "public, max-age=604800, immutable"
      }
    },
    {
      "route": "/cardforge/*.js",
      "allowedRoles": ["anonymous"],
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "route": "/cardforge/images/*",
      "allowedRoles": ["anonymous"],
      "headers": {
        "Cache-Control": "public, max-age=604800"
      }
    },
    {
      "route": "/images/*",
      "headers": {
        "Cache-Control": "public, max-age=604800"
      }
    }
  ],
  "auth": {
    "identityProviders": {
      "azureActiveDirectory": {
        "registration": {
          "openIdIssuer": "https://ambientpixelsid.ciamlogin.com/ambientpixelsid.onmicrosoft.com/v2.0/",
          "clientIdSettingName": "B2C_CLIENT_ID"
        },
        "login": {
          "loginParameters": [
            "p=SignUpSignIn",
            "scope=openid profile",
            "response_type=id_token",
            "response_mode=form_post"
          ],
          "nameClaimType": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name"
        },
        "redirectToProvider": "azureActiveDirectory",
        "redirectToProviderOptions": {
          "postLoginRedirectUri": "/.auth/login/aad/callback"
        }
      }
    },
    "login": {
      "externalUrl": "/.auth/login/aad"
    }
  }
}