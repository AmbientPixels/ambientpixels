    },
    {
      "route": "/api/company-standup-run",
      "rewrite": "https://ambientpixels-nova-api.azurewebsites.net/api/company-standup-run",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/linkedin-test",
      "rewrite": "https://ambientpixels-nova-api.azurewebsites.net/api/linkedin-test",
