{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/.auth/*",
      "/images/*",
      "/*.css",
      "/*.js",
      "/*.json",
      "/*.svg",
      "/*.png",
      "/*.ico",
      "/*.jpg",
      "/*.jpeg",
      "/*.gif"
    ]
  },
  "mimeTypes": {
    ".json": "text/json"
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 404
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "X-XSS-Protection": "1; mode=block",
    "Content-Security-Policy": "default-src 'self'; script-src 'self' https://js.monitor.azure.com https://cdnjs.cloudflare.com 'unsafe-inline' 'unsafe-eval'; style-src 'self' https://fonts.googleapis.com https://cdnjs.cloudflare.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https://*.ambientpixels.ai; connect-src 'self' https://*.ambientpixels.ai https://*.azure.com https://*.applicationinsights.azure.com https://ambientpixelsai.ciamlogin.com"
  },
  "routes": [
    {
      "route": "/api/cardforgesavecards",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/cardforgepublish",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/cardforgeloadcards",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/api/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/cardforge/*.css",
      "headers": {
        "Cache-Control": "public, max-age=604800, immutable"
      }
    },
    {
      "route": "/cardforge/*.js",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "route": "/cardforge/images/*",
      "headers": {
        "Cache-Control": "public, max-age=604800"
      }
    },
    {
      "route": "/images/*",
      "headers": {
        "Cache-Control": "public, max-age=604800"
      }
    }
  ],
  "auth": {
    "identityProviders": {
      "azureActiveDirectory": {
        "registration": {
          "openIdIssuer": "https://ambientpixelsid.ciamlogin.com/ambientpixelsid.onmicrosoft.com/v2.0/",
          "clientIdSettingName": "B2C_CLIENT_ID"
        },
        "login": {
          "loginParameters": [
            "p=SignUpSignIn",
            "scope=openid profile",
            "response_type=id_token",
            "response_mode=form_post"
          ],
          "nameClaimType": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name"
        },
        "redirectToProvider": "azureActiveDirectory",
        "redirectToProviderOptions": {
          "postLoginRedirectUri": "/.auth/login/aad/callback"
        }
      }
    },
    "login": {
      "externalUrl": "/.auth/login/aad"
    },
    "responseOverrides": {
      "401": {
        "redirect": "/.auth/login/aad?post_login_redirect_uri=/",
        "statusCode": 302
      }
    }
  }
}