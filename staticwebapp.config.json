{
  "platform": {
    "apiRuntime": "node:20"
  },
  "allowedForwardedHosts": [
    "ambientpixels-nova-api.azurewebsites.net"
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/.auth/*",
      "/images/*",
      "/lab/*",
      "/api/*",
      "/*.css",
      "/*.js",
      "/*.json",
      "/*.svg",
      "/*.png",
      "/*.ico",
      "/*.jpg",
      "/*.jpeg",
      "/*.gif"
    ]
  },
  "mimeTypes": {
    ".json": "text/json"
  },
  "responseOverrides": {
    "401": {
      "rewrite": "/pages/401.html",
      "statusCode": 401
    },
    "404": {
      "rewrite": "/index.html",
      "statusCode": 404
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "X-XSS-Protection": "1; mode=block",
    "Content-Security-Policy": "default-src 'self'; script-src 'self' https://js.monitor.azure.com https://cdnjs.cloudflare.com https://cdn.jsdelivr.net https://alcdn.msauth.net 'unsafe-inline' 'unsafe-eval'; style-src 'self' https://fonts.googleapis.com https://cdnjs.cloudflare.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https://*.ambientpixels.ai https://cardforgeblobdata.blob.core.windows.net; connect-src 'self' https://*.ambientpixels.ai https://ambientpixels-nova-api.azurewebsites.net https://*.azure.com https://*.applicationinsights.azure.com https://ambientpixelsai.ciamlogin.com https://login.microsoftonline.com https://*.login.microsoftonline.com https://cardforgeblobdata.blob.core.windows.net; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com;"
  },
  "routes": [
    {
      "route": "/blog/*.css"
    },
    {
      "route": "/blog/*.js"
    },
    {
      "route": "/blog/*",
      "rewrite": "/blog/index.html"
    },
    {
      "route": "/log/*.css"
    },
    {
      "route": "/log/*.js"
    },
    {
      "route": "/log/*",
      "rewrite": "/log/index.html"
    },
    {
      "route": "/modules/company/css/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/modules/company/demo.html",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/modules/company/*",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/docs/published/*",
      "rewrite": "/docs/published/index.html",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/hanson*",
      "allowedRoles": ["hansonuser"]
    },
    {
      "route": "/api/cardforgesavecards",
      "rewrite": "https://ambientpixels-nova-api.azurewebsites.net/api/cardforgesavecards",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/cardforgetemplate",
      "rewrite": "https://ambientpixels-nova-api.azurewebsites.net/api/cardforgetemplate",
