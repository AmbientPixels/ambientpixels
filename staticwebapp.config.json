{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/.auth/*",
      "/images/*",
      "/*.css",
      "/*.js",
      "/*.json",
      "/*.svg",
      "/*.png",
      "/*.ico",
      "/*.jpg",
      "/*.jpeg",
      "/*.gif"
    ]
  },
  "mimeTypes": {
    ".json": "text/json"
  },
  "responseOverrides": {
    "404": {
      "rewrite": "/index.html",
      "statusCode": 404
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "X-XSS-Protection": "1; mode=block",
    "Content-Security-Policy": "default-src 'self'; script-src 'self' https://js.monitor.azure.com https://cdnjs.cloudflare.com 'unsafe-inline' 'unsafe-eval'; style-src 'self' https://fonts.googleapis.com https://cdnjs.cloudflare.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https://*.ambientpixels.ai; connect-src 'self' https://*.ambientpixels.ai https://*.azure.com https://*.applicationinsights.azure.com https://ambientpixelsai.ciamlogin.com"
  },
  "routes": [
    {
      "route": "/api/cardforgesavecards",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/cardforgepublish",
      "allowedRoles": ["authenticated"]
    },
    {
      "route": "/api/cardforgeloadcards",
      "allowedRoles": ["anonymous", "authenticated"]
    },
    {
      "route": "/api/*",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/cardforge/*.css",
      "headers": {
        "Cache-Control": "public, max-age=604800, immutable"
      }
    },
    {
      "route": "/cardforge/*.js",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "route": "/cardforge/images/*",
      "headers": {
        "Cache-Control": "public, max-age=604800"
      }
    },
    {
      "route": "/images/*",
      "headers": {
        "Cache-Control": "public, max-age=604800"
      }
    }
  ],
  "auth": {
    "identityProviders": {
      "azureActiveDirectoryB2C": {
        "registration": {
          "clientId": "d0685388-9f8e-4a5f-918f-7070a8b41cb5",
          "tenantId": "5e8db895-96f8-43ed-ad90-05fc041f771b",
          "loginParameters": [
            "p=SignUpSignIn"
          ]
        }
      }
    }
  }
}