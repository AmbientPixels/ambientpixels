{
  "platform": {
    "apiRuntime": "node:20"
  },
  "allowedForwardedHosts": [
    "ambientpixels-nova-api.azurewebsites.net"
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/.auth/*",
      "/images/*",
      "/lab/*",
      "/api/*",
      "/*.css",
      "/*.js",
      "/*.json",
      "/*.svg",
      "/*.png",
      "/*.ico",
      "/*.jpg",
      "/*.jpeg",
      "/*.gif"
    ]
  },
  "mimeTypes": {
    ".json": "text/json"
  },
  "responseOverrides": {
    "401": {
      "rewrite": "/pages/401.html",
      "statusCode": 401
    },
    "404": {
      "rewrite": "/index.html",
      "statusCode": 404
    }
  },
  "globalHeaders": {
    "X-Content-Type-Options": "nosniff",
    "X-Frame-Options": "DENY",
    "X-XSS-Protection": "1; mode=block",
    "Content-Security-Policy": "default-src 'self'; script-src 'self' https://js.monitor.azure.com https://cdnjs.cloudflare.com https://alcdn.msauth.net 'unsafe-inline' 'unsafe-eval'; style-src 'self' https://fonts.googleapis.com https://cdnjs.cloudflare.com 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: blob: https://*.ambientpixels.ai https://cardforgeblobdata.blob.core.windows.net; connect-src 'self' https://*.ambientpixels.ai https://ambientpixels-nova-api.azurewebsites.net https://*.azure.com https://*.applicationinsights.azure.com https://ambientpixelsai.ciamlogin.com https://login.microsoftonline.com https://*.login.microsoftonline.com https://cardforgeblobdata.blob.core.windows.net; frame-src 'self' https://www.youtube.com https://www.youtube-nocookie.com;"
  },
  "routes": [
    {
      "route": "/hanson*",
      "allowedRoles": ["hansonuser"]
    },
    {
      "route": "/api/cardforgesavecards",
      "rewrite": "https://ambientpixels-nova-api.azurewebsites.net/api/cardforgesavecards",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/cardforgetemplate",
      "rewrite": "https://ambientpixels-nova-api.azurewebsites.net/api/cardforgetemplate",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/cardforgepublish",
      "rewrite": "https://ambientpixels-nova-api.azurewebsites.net/api/cardforgepublish",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/cardforgedeckpublish",
      "rewrite": "https://ambientpixels-nova-api.azurewebsites.net/api/cardforgedeckpublish",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/cardforgedeckload",
      "rewrite": "https://ambientpixels-nova-api.azurewebsites.net/api/cardforgedeckload",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/cardforgedeckdelete",
      "rewrite": "https://ambientpixels-nova-api.azurewebsites.net/api/cardforgedeckdelete",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/cardforgedeletecard",
      "rewrite": "https://ambientpixels-nova-api.azurewebsites.net/api/cardforgedeletecard",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/cardforgeloadcards",
      "rewrite": "https://ambientpixels-nova-api.azurewebsites.net/api/cardforgeloadcards",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/cardshare",
      "rewrite": "https://ambientpixels-nova-api.azurewebsites.net/api/cardshare",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/geminiproxy",
      "rewrite": "https://ambientpixels-nova-api.azurewebsites.net/api/geminiproxy",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/novachat",
      "rewrite": "https://ambientpixels-nova-api.azurewebsites.net/api/novachat",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/agentchat",
      "rewrite": "https://ambientpixels-nova-api.azurewebsites.net/api/agentchat",
      "allowedRoles": ["anonymous"]
    },
    {
      "route": "/api/*",
      "rewrite": "https://ambientpixels-nova-api.azurewebsites.net/api/{path}"
    },
    {
      "route": "/cardforge/*.css",
      "allowedRoles": ["anonymous"],
      "headers": {
        "Cache-Control": "public, max-age=604800, immutable"
      }
    },
    {
      "route": "/cardforge/*.js",
      "allowedRoles": ["anonymous"],
      "headers": {
        "Cache-Control": "public, max-age=86400"
      }
    },
    {
      "route": "/cardforge/images/*",
      "allowedRoles": ["anonymous"],
      "headers": {
        "Cache-Control": "public, max-age=604800"
      }
    },
    {
      "route": "/images/*",
      "headers": {
        "Cache-Control": "public, max-age=604800"
      }
    }
  ],
  "auth": {
    "identityProviders": {
      "azureActiveDirectory": {
        "registration": {
          "openIdIssuer": "https://ambientpixelsid.ciamlogin.com/ambientpixelsid.onmicrosoft.com/v2.0/",
          "clientIdSettingName": "B2C_CLIENT_ID"
        },
        "login": {
          "loginParameters": [
            "p=SignUpSignIn",
            "scope=openid profile",
            "response_type=id_token",
            "response_mode=form_post"
          ],
          "nameClaimType": "http://schemas.xmlsoap.org/ws/2005/05/identity/claims/name"
        },
        "redirectToProvider": "azureActiveDirectory",
        "redirectToProviderOptions": {
          "postLoginRedirectUri": "/.auth/login/aad/callback"
        }
      }
    },
    "login": {
      "externalUrl": "/.auth/login/aad"
    }
  }
}