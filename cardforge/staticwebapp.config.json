{
  "routes": [
    {
      "route": "/api/cardforge/savecards",
      "allowedRoles": [ "authenticated" ]
    },
    {
      "route": "/api/cardforge/mycards",
      "allowedRoles": [ "authenticated" ]
    },
    {
      "route": "/api/cardforge/cardpublish",
      "allowedRoles": [ "authenticated" ]
    },
    {
      "route": "/api/cardforge/cards",
      "allowedRoles": [ "authenticated" ]
    },
    {
      "route": "/api/cardforge/debug",
      "allowedRoles": [ "authenticated" ]
    }
  ],
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/images/*",
      "/css/*",
      "/js/*",
      "/auth/*",
      "/cardforge/*",
      "/modules/*",
      "/*.{ico,png,json,txt,webmanifest}"
    ]
  },
  "responseOverrides": {
    "401": {
      "rewrite": "/index.html",
      "statusCode": 302
    }
  }
}
